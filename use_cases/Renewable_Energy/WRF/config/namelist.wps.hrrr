&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_date = '2025-04-07_06:00:00',
 end_date   = '2025-04-09_06:00:00',
 interval_seconds = 3600,
 io_form_geogrid = 2,
 opt_output_from_geogrid_path = '/tmp/renewable_energy'
/

&geogrid
 parent_id         =   1,    1,   2,
 parent_grid_ratio =   1,    3,   3,
 i_parent_start    =   1,  161, 161,
 j_parent_start    =   1,   16,  16,
 e_we              =  265, 265, 265,
 e_sn              =  265, 265, 265,
 geog_data_res = 'modis_lakes+30s','modis_lakes+30s','modis_lakes+30s',
 dx = 3000,
 dy = 3000,
 map_proj = 'lambert',
 ref_lat   =  43.00,
 ref_lon   = -76.00,
 truelat1  =  40.0,
 truelat2  =  46.0,
 stand_lon = -76.0,
 geog_data_path = '/home/wrfuser/terrestrial_data/geog'
 opt_geogrid_tbl_path = '/home/wrfuser/WPS/geogrid'
/

&ungrib
 out_format = 'WPS',
 prefix = '/tmp/renewable_energy/HRRR_pres',
/

&metgrid
 fg_name = '/tmp/renewable_energy/HRRR_pres',
 io_form_metgrid = 2,
 constants_name = '/home/wrfuser/terrestrial_data/wps_files/QNWFA_QNIFA_QNBCA_SIGMA_MONTHLY.dat', 'TAVGSFC',
 opt_output_from_metgrid_path = '/tmp/renewable_energy',
 opt_metgrid_tbl_path = '/home/wrfuser/WPS/metgrid'
/
